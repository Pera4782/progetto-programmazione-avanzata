<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<fx:root alignment="TOP_CENTER" fillWidth="false" prefWidth="700" spacing="40" styleClass="main-container" stylesheets="@newAppointmentScreen.css" type="javafx.scene.layout.VBox" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    
    <padding>
        <Insets bottom="60" left="80" right="80" top="60" />
    </padding>

    <Label styleClass="header-label" text="Nuova Prenotazione Medica" />

    <VBox alignment="CENTER_LEFT" maxWidth="350" prefWidth="350" spacing="20">
        <VBox fillWidth="true" spacing="5">
            <Label text="Data:" />
            <DatePicker fx:id="dateField" maxWidth="Infinity" prefWidth="250" />
        </VBox>

        <VBox fillWidth="true" spacing="5">
            <Label text="Ora:" />
            <ComboBox fx:id="timeField" maxWidth="Infinity" prefWidth="250" promptText="Seleziona orario">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="09:00" />
                        <String fx:value="09:30" />
                        <String fx:value="10:00" />
                        <String fx:value="10:30" />
                        <String fx:value="11:00" />
                        <String fx:value="11:30" />
                        <String fx:value="12:00" />
                        <String fx:value="12:30" />
                        <String fx:value="14:00" />
                        <String fx:value="14:30" />
                        <String fx:value="15:00" />
                        <String fx:value="15:30" />
                        <String fx:value="16:00" />
                        <String fx:value="16:30" />
                        <String fx:value="17:00" />
                        <String fx:value="17:30" />
                    </FXCollections>
                </items>
            </ComboBox>
        </VBox>

        <VBox fillWidth="true" spacing="5">
            <Label text="Tipo Visita:" />
            <TextField fx:id="typeField" maxWidth="Infinity" prefWidth="350" promptText="Tipo di prestazione" />
        </VBox>
    </VBox>
     <Button fx:id="createAppointmentButton" alignment="TOP_CENTER" onAction="#createAppointment" styleClass="button-primary" text="Crea Appuntamento" />
   <Label fx:id="message" alignment="CENTER" prefHeight="75.0" prefWidth="663.0" text="Label" textAlignment="CENTER" textFill="#b50000" visible="false" wrapText="true">
      <font>
         <Font name="System Bold" size="16.0" />
      </font>
   </Label>

</fx:root>
