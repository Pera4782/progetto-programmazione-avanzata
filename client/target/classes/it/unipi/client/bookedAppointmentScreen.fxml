<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<fx:root spacing="10" stylesheets="@bookedAppointmentScreen.css" type="javafx.scene.layout.VBox" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    
    <HBox spacing="10" styleClass="days-header">
        <Button fx:id="date0" onAction="#loadAppointmentsTable" styleClass="day-button" text="LUN" />
        <Button fx:id="date1" onAction="#loadAppointmentsTable" styleClass="day-button" text="MAR" />
        <Button fx:id="date2" onAction="#loadAppointmentsTable" styleClass="day-button" text="MER" />
        <Button fx:id="date3" onAction="#loadAppointmentsTable" styleClass="day-button" text="GIO" />
        <Button fx:id="date4" onAction="#loadAppointmentsTable" styleClass="day-button" text="VEN" />
        <Button onAction="#showPrevDates" styleClass="day-button" text="←" />
        <Button onAction="#showNextDates" styleClass="day-button" text="→" />
    </HBox>

    <TableView fx:id="appointmentsTable" styleClass="appointments-table" visible="false" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="patientColumn" text="Nome Paziente" />
            <TableColumn fx:id="timeColumn" text="Orario" />
            <TableColumn fx:id="typeColumn" text="Tipo" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <contextMenu>
            <ContextMenu>
                <items>
                    <MenuItem onAction="#removeVisita" text="Elimina" />
                </items>
            </ContextMenu>
        </contextMenu>
    </TableView>

</fx:root>
