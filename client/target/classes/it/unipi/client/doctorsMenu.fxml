<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@doctorsMenu.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    
    <left>
        <VBox prefWidth="280.0" spacing="10" styleClass="sidebar">
            <padding>
                <Insets bottom="20" left="10" right="10" top="20" />
            </padding>
            
            <Label styleClass="logo-text" text="MED-CONNECT" />
            
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Button styleClass="nav-button, nav-button-active" text="Appuntamenti" />
                <Button styleClass="nav-button" text="Aggiungi appuntamenti" />
                <Button styleClass="nav-button" text="Pazienti" />
            </VBox>
            
            <Button maxWidth="Infinity" styleClass="logout-button" text="Esci" />
        </VBox>
    </left>

    <center>
        <VBox spacing="20" styleClass="main-content">
            <padding>
                <Insets bottom="25" left="30" right="30" top="25" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20">
                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                    <Label styleClass="doctor-name" text="Dr. Tommaso Peruzzi" />
                </HBox>
                <Button styleClass="top-bar-button" text="Ricarica" />
            </HBox>

            <Label styleClass="section-title" text="PROSSIMI APPUNTAMENTI" />

            <VBox prefHeight="524.0" prefWidth="718.0" spacing="10" styleClass="appointments-container" VBox.vgrow="ALWAYS">
                <HBox spacing="10" styleClass="days-header">
                    <Button styleClass="day-button-active" text="LUN" />
                    <Button styleClass="day-button" text="MAR" />
                    <Button styleClass="day-button" text="MER" />
                    <Button styleClass="day-button" text="GIO" />
                    <Button styleClass="day-button" text="VEN" />
                </HBox>

                <TableView fx:id="appointmentsTable" styleClass="appointments-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="patientColumn" text="Nome Paziente" />
                        <TableColumn fx:id="timeColumn" text="Orario" />
                        <TableColumn fx:id="reasonColumn" text="Motivo" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button styleClass="pagination-button" text="Precedente" />
                    <Button styleClass="pagination-button" text="Successivo" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
