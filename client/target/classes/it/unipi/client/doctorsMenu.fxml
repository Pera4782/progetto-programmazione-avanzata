<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@doctorsMenu.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.unipi.client.DoctorsMenuController">
    
    <left>
        <VBox prefWidth="280.0" spacing="10" styleClass="sidebar">
            <padding>
                <Insets bottom="20" left="10" right="10" top="20" />
            </padding>
            
            <Label styleClass="logo-text" text="MED-CONNECT" />
            
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Button fx:id="navButton0" onAction="#switchScreen" styleClass="nav-button, nav-button-active" text="Appuntamenti" />
                <Button fx:id="navButton1" onAction="#switchScreen" styleClass="nav-button" text="Aggiungi appuntamenti" />
                <Button fx:id="navButton2" onAction="#switchScreen" styleClass="nav-button" text="Pazienti" />
            </VBox>
            
            <Button maxWidth="Infinity" onAction="#logout" styleClass="logout-button" text="Esci" />
        </VBox>
    </left>

    <center>
        <VBox spacing="20" styleClass="main-content">
            <padding>
                <Insets bottom="25" left="30" right="30" top="25" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20">
                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                    <Label fx:id="doctorNameLabel" styleClass="doctor-name" text="Dr. Tommaso Peruzzi" />
                </HBox>
                <Button onAction="#reload" styleClass="top-bar-button" text="Ricarica" />
            </HBox>

            <Label styleClass="section-title" text="PROSSIMI APPUNTAMENTI" />

            <VBox fx:id="mainContainer" prefHeight="524.0" prefWidth="718.0" spacing="10" styleClass="appointments-container" VBox.vgrow="ALWAYS">
                <HBox spacing="10" styleClass="days-header">
                    <Button fx:id="date0" onAction="#loadAppointmentsTable" styleClass="day-button" text="LUN" />
                    <Button fx:id="date1" onAction="#loadAppointmentsTable" styleClass="day-button" text="MAR" />
                    <Button fx:id="date2" onAction="#loadAppointmentsTable" styleClass="day-button" text="MER" />
                    <Button fx:id="date3" onAction="#loadAppointmentsTable" styleClass="day-button" text="GIO" />
                    <Button fx:id="date4" onAction="#loadAppointmentsTable" styleClass="day-button" text="VEN" />
                    <Button onAction="#showPrevDates" styleClass="day-button" text="←" />
                    <Button onAction="#showNextDates" styleClass="day-button" text="→" />
                </HBox>

                <TableView fx:id="appointmentsTable" styleClass="appointments-table" visible="false" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="patientColumn" text="Nome Paziente" />
                        <TableColumn fx:id="timeColumn" text="Orario" />
                        <TableColumn fx:id="reasonColumn" text="Motivo" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button styleClass="pagination-button" text="Precedente" />
                    <Button styleClass="pagination-button" text="Successivo" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
